{
    "generate_size": 100,
    "unique_combinations_only": true,

    "dictionaries": {
        "COUNTRY": "data/ner/simulator/uae/dictionaries/country.txt",
        "EMIRATE": "data/ner/simulator/uae/dictionaries/emirate.txt",
        "CITY": "data/ner/simulator/uae/dictionaries/city.txt",
        "SUB_AREA": "data/ner/simulator/uae/dictionaries/sub_area.txt",
        "COMPOUND": "data/ner/simulator/uae/dictionaries/compound.txt",
        "STREET": "data/ner/simulator/uae/dictionaries/street.txt",
        "BUILDING": "data/ner/simulator/uae/dictionaries/building.txt"
    },

    "templates": {
        "definitions": [
            {
                "pattern": "{BUILDING} {EMIRATE} {COUNTRY}",
                "weight": 0.136
            },
            {
                "pattern": "{BUILDING} {SUB_AREA} {EMIRATE} {COUNTRY}",
                "weight": 0.124
            },
            {
                "pattern": "{STREET} {BUILDING} {EMIRATE} {COUNTRY}",
                "weight": 0.119
            },
            {
                "pattern": "{COMPOUND} {BUILDING} {EMIRATE} {COUNTRY}",
                "weight": 0.083
            },
            {
                "pattern": "{STREET} {BUILDING} {CITY} {EMIRATE} {COUNTRY}",
                "weight": 0.069
            },
            {
                "pattern": "{BUILDING} {COMPOUND} {EMIRATE} {COUNTRY}",
                "weight": 0.046
            },
            {
                "pattern": "{STREET} {BUILDING} {SUB_AREA} {EMIRATE} {COUNTRY}",
                "weight": 0.041
            },
            {
                "pattern": "{SUB_AREA} {BUILDING} {EMIRATE} {COUNTRY}",
                "weight": 0.041
            },
            {
                "pattern": "{BUILDING} {STREET} {SUB_AREA} {EMIRATE} {COUNTRY}",
                "weight": 0.037
            },
            {
                "pattern": "{COMPOUND} {CITY} {EMIRATE} {COUNTRY}",
                "weight": 0.03
            },
            {
                "pattern": "{COMPOUND} {BUILDING} {SUB_AREA} {EMIRATE} {COUNTRY}",
                "weight": 0.028
            },
            {
                "pattern": "{COMPOUND} {STREET} {BUILDING} {EMIRATE} {COUNTRY}",
                "weight": 0.028
            },
            {
                "pattern": "{BUILDING} {COMPOUND} {SUB_AREA} {EMIRATE} {COUNTRY}",
                "weight": 0.025
            },
            {
                "pattern": "{STREET} {BUILDING} {COMPOUND} {EMIRATE} {COUNTRY}",
                "weight": 0.025
            },
            {
                "pattern": "{BUILDING} {STREET} {EMIRATE} {COUNTRY}",
                "weight": 0.024
            },
            {
                "pattern": "{STREET} {COMPOUND} {BUILDING} {EMIRATE} {COUNTRY}",
                "weight": 0.022
            },
            {
                "pattern": "{STREET} {SUB_AREA} {BUILDING} {EMIRATE} {COUNTRY}",
                "weight": 0.021
            },
            {
                "pattern": "{COMPOUND} {SUB_AREA} {EMIRATE} {COUNTRY}",
                "weight": 0.019
            },
            {
                "pattern": "{BUILDING} {STREET} {COMPOUND} {EMIRATE} {COUNTRY}",
                "weight": 0.019
            },
            {
                "pattern": "{STREET} {COMPOUND} {EMIRATE} {COUNTRY}",
                "weight": 0.018
            },
            {
                "pattern": "{STREET} {SUB_AREA} {CITY} {EMIRATE} {COUNTRY}",
                "weight": 0.015
            },
            {
                "pattern": "{STREET} {CITY} {EMIRATE} {COUNTRY}",
                "weight": 0.015
            },
            {
                "pattern": "{COMPOUND} {EMIRATE} {BUILDING} {COUNTRY}",
                "weight": 0.015
            }
        ],
        "separator_variations": {
            "options": [","],
            "probability": 0.6
        }
    },
    
    "typo_injection": {
        "enabled": true,
        "global_probability": 0.4,
        "case_variations": {
            "enabled": true,
            "probability": 0.3,
            "strategies": {
                "normal_case": 0.4,
                "all_lowercase": 0.35,
                "all_uppercase": 0.15,
                "random_case": 0.1
            }
        },
        "per_entity_config": {
            "BUILDING": {
                "probability": 0.4,
                "max_char_error_ratio": 0.15,
                "typo_types": {
                    "swap": 0.4,
                    "deletion": 0.3,
                    "insertion": 0.2,
                    "substitution": 0.1
                }
            },
            "STREET": {
                "probability": 0.2,
                "max_char_error_ratio": 0.12,
                "typo_types": {
                    "swap": 0.4,
                    "deletion": 0.3,
                    "insertion": 0.2,
                    "substitution": 0.1
                }
            },
            "COMPOUND": {
                "probability": 0.2,
                "max_char_error_ratio": 0.10,
                "typo_types": {
                    "swap": 0.5,
                    "deletion": 0.25,
                    "insertion": 0.15,
                    "substitution": 0.1
                }
            },
            "SUB_AREA": {
                "probability": 0.2,
                "max_char_error_ratio": 0.08,
                "typo_types": {
                    "swap": 0.5,
                    "deletion": 0.3,
                    "insertion": 0.15,
                    "substitution": 0.05
                }
            },
            "CITY": {
                "probability": 0.05,
                "max_char_error_ratio": 0.05,
                "typo_types": {
                    "swap": 0.6,
                    "deletion": 0.2,
                    "insertion": 0.15,
                    "substitution": 0.05
                }
            },
            "EMIRATE": {
                "probability": 0.05,
                "max_char_error_ratio": 0.05,
                "typo_types": {
                    "swap": 0.6,
                    "deletion": 0.2,
                    "insertion": 0.15,
                    "substitution": 0.05
                }
            },
            "COUNTRY": {
                "probability": 0.05,
                "max_char_error_ratio": 0.03,
                "typo_types": {
                    "swap": 0.7,
                    "deletion": 0.2,
                    "insertion": 0.08,
                    "substitution": 0.02
                }
            }
        }
    },
    
    "noise_injection": {
        "enabled": true,
        "global_noise_probability": 0.5,
        "max_noise_per_address": 3,
        "noise_types": {
            "punctuation": {
                "enabled": true,
                "probability": 0.3,
                "characters": [".", ",", ";", "-", "—", "/", "\\", "@", "#", "%", "*", "&"],
                "max_consecutive": 3
            },
            "numbers": {
                "enabled": true,
                "probability": 0.4,
                "patterns": {
                    "random_digits": {
                        "min_length": 1,
                        "max_length": 3,
                        "probability": 0.8
                    },
                    "phone_like": {
                        "format": "+971XXXXXXXXX",
                        "probability": 0.1
                    },
                    "po_box": {
                        "format": "P.O. Box XXXXX",
                        "probability": 0.1
                    }
                }
            },
            "meaningless_words": {
                "enabled": true,
                "probability": 0.2,
                "word_list": [
                    "Near", "Opposite", "Behind", "Next to", "Close to", "beside",
                    "بجانب", "قريب من", "مقابل", "خلف", "أمام",
                    "Floor", "Unit", "Block", "Gate", "Door", "Room", "Flat", "Apartment",
                    "الطابق", "الوحدة", "غرفة", "شقة",
                    "North", "South", "East", "West", "Central",
                    "Before", "After", "Front", "Back", "Left", "Right"
                ],
                "max_per_address": 2
            }
        }
    },
    
    
    "output": {
        "format": "csv",
        "output_dir": "../raw_data/",
        "file_prefix": "simulated_",
        "timestamp_suffix": true,
        "fields": ["formatted_address", "BUILDING", "STREET", "COMPOUND", "SUB_AREA", "CITY", "EMIRATE", "COUNTRY"],
        "deduplicate": true,
        "shuffle": false,
        "include_metadata": false,
        "quality_validation": {
            "enabled": true,
            "min_address_length": 10,
            "max_address_length": 512
        }
    }
}

