{
    "country": {
        "code": "uae_google",
        "name": "United Arab Emirates",
        "language": "ar",
        "description": "Configuration for UAE address parsing with comprehensive entity recognition"
    },
    "model": {
        "name": "uae_address_ner",
        "type": "bert",
        "pretrained_model": "aubmindlab/bert-base-arabertv2",
        "max_length": 512,
        "dropout": 0.1,
        "hidden_size": 768,
        "num_attention_heads": 12,
        "num_hidden_layers": 12
    },
    "training": {
        "epochs": 4,
        "batch_size": 32,
        "learning_rate": 3e-5,
        "optimizer": "adamw",
        "scheduler": "linear",
        "warmup_steps": 1000,
        "weight_decay": 0.01,
        "gradient_accumulation_steps": 1,
        "max_grad_norm": 1.0,
        "early_stopping": {
            "enabled": true,
            "patience": 5,
            "min_delta": 0.001
        },
        "validation_steps": 500,
        "logging_steps": 100
    },
    "data": {
        "train_file": "data/ner/data/uae_google/generated.jsonl",
        "val_file": "data/ner/data/uae_google/validation.jsonl",
        "test_file": "data/ner/data/uae_google/test.jsonl",
        "data_format": "jsonl",
        "text_column": "text",
        "labels_column": "labels",
        "preprocessing": {
            "lowercase": false,
            "remove_diacritics": true,
            "normalize_whitespace": true,
            "remove_special_chars": false
        },
        "augmentation": {
            "enabled": false,
            "techniques": []
        }
    },
    "labels": {
        "num_labels": 17,
        "label_names": [
            "O",
            "B-COUNTRY", "I-COUNTRY",
            "B-EMIRATE", "I-EMIRATE",
            "B-CITY", "I-CITY",
            "B-SUB_AREA", "I-SUB_AREA",
            "B-COMPOUND", "I-COMPOUND",
            "B-STREET", "I-STREET",
            "B-BUILDING", "I-BUILDING",
            "B-HOUSE_NUMBER", "I-HOUSE_NUMBER"
        ],
        "label_mapping": {
            "O": 0,
            "B-COUNTRY": 1,
            "I-COUNTRY": 2,
            "B-EMIRATE": 3,
            "I-EMIRATE": 4,
            "B-CITY": 5,
            "I-CITY": 6,
            "B-SUB_AREA": 7,
            "I-SUB_AREA": 8,
            "B-COMPOUND": 9,
            "I-COMPOUND": 10,
            "B-STREET": 11,
            "I-STREET": 12,
            "B-BUILDING": 13,
            "I-BUILDING": 14,
            "B-HOUSE_NUMBER": 15,
            "I-HOUSE_NUMBER": 16
        },
        "label_descriptions": {
            "O": "Outside any entity",
            "B-COUNTRY": "Beginning of country name (الإمارات العربية المتحدة)",
            "I-COUNTRY": "Inside country name",
            "B-EMIRATE": "Beginning of emirate name (دبي، أبوظبي، الشارقة، etc.)",
            "I-EMIRATE": "Inside emirate name",
            "B-CITY": "Beginning of city name (دبي، أبوظبي، العين، etc.)",
            "I-CITY": "Inside city name",
            "B-SUB_AREA": "Beginning of sub-area/district (منطقة فرعية)",
            "I-SUB_AREA": "Inside sub-area/district",
            "B-COMPOUND": "Beginning of compound/community name (مجمع سكني)",
            "I-COMPOUND": "Inside compound/community name",
            "B-STREET": "Beginning of street name (شارع الشيخ زايد، etc.)",
            "I-STREET": "Inside street name",
            "B-BUILDING": "Beginning of building name (برج خليفة، etc.)",
            "I-BUILDING": "Inside building name",
            "B-HOUSE_NUMBER": "Beginning of house/unit number (رقم المنزل/الوحدة)",
            "I-HOUSE_NUMBER": "Inside house/unit number"
        }
    },
    "evaluation": {
        "metrics": ["precision", "recall", "f1", "accuracy", "entity_f1"],
        "save_predictions": true,
        "save_detailed_report": true,
        "compute_per_label_metrics": true,
        "confusion_matrix": true
    },
    "output": {
        "model_dir": "data/ner/models/uae_google",
        "save_steps": 1000,
        "save_total_limit": 3,
        "overwrite_output_dir": true,
        "save_best_model": true,
        "load_best_model_at_end": true
    },
    "hardware": {
        "device": "auto",
        "mixed_precision": true,
        "dataloader_num_workers": 4,
        "pin_memory": true,
        "gradient_checkpointing": false
    },
    "logging": {
        "level": "INFO",
        "log_file": "uae_training.log",
        "error_log_file": "uae_errors.log",
        "wandb": {
            "enabled": false,
            "project": "uae-address-ner",
            "entity": null,
            "tags": ["uae", "address", "ner", "arabic"]
        },
        "tensorboard": {
            "enabled": true,
            "log_dir": "data/ner/logs/tensorboard/uae_google"
        }
    }
}