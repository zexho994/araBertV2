{
    "country": {
        "code": "uae",
        "name": "UAE",
        "language": "",
        "description": "desc for Uae Xml Roberta Base"
    },
    "model": {
        "name": "XLM-RoBERTa",
        "type": "bert",
        "pretrained_model": "data/ner/models/uae/v0.1",
        "max_length": 512,
        "hidden_size": 768,
        "num_attention_heads": 12,
        "num_hidden_layers": 12,
        "dropout": 0.25,
        "config": {
            "hidden_dropout_prob": 0.1,
            "attention_probs_dropout_prob": 0.2
        },
        "transformers_config": {
            "architectures": ["XLMRobertaForTokenClassification"],
            "attention_probs_dropout_prob": 0.1,
            "bos_token_id": 0,
            "classifier_dropout": null,
            "eos_token_id": 2,
            "hidden_act": "gelu",
            "hidden_dropout_prob": 0.1,
            "hidden_size": 768,
            "initializer_range": 0.02,
            "intermediate_size": 3072,
            "layer_norm_eps": 1e-05,
            "max_position_embeddings": 514,
            "model_type": "xlm-roberta",
            "num_attention_heads": 12,
            "num_hidden_layers": 12,
            "pad_token_id": 1,
            "position_embedding_type": "absolute",
            "transformers_version": "4.21.0",
            "type_vocab_size": 1,
            "use_cache": true,
            "vocab_size": 250002
        }
    },
    "training": {
        "epochs": 2,
        "batch_size": 16,
        "learning_rate": 1e-4,
        "weight_decay": 0.03,
        "warmup_steps": 500,
        "warmup_ratio": 0.1,
        "optimizer": "adamw",
        "scheduler": "linear",
        "early_stopping_patience": 2,
        "max_grad_norm": 1.0,
        "save_steps": 1000,
        "eval_steps": 500,
        "logging_steps": 100,
        "lora": {
            "enabled": true,
            "r": 16,
            "alpha": 32,
            "dropout": 0.1,
            "target_modules": ["query", "key", "value", "dense"],
            "bias": "none",
            "task_type": "TOKEN_CLS",
            "base_adapter": "data/ner/models/uae/v0.1"
        }
    },
    "data": {
        "train_file": "data/ner/datasets/uae/train_250916.jsonl",
        "val_file": "data/ner/datasets/uae/eval_250916.jsonl",
        "test_file": "data/ner/datasets/uae/test.jsonl",
        "max_length": 512,
        "doc_stride": 128,
        "preprocessing": {
            "lowercase": false,
            "remove_accents": false,
            "tokenize_chinese_chars": true
        },
        "preprocessing_pipeline": [
            { "step": "unicode_normalize", "params": { "form": "NFC" } },
            { "step": "digit_normalize" },
            { "step": "punctuation_normalize" },
            { "step": "arabic_diacritics_filter" },
            { "step": "punctuation_filter"},
            { "step": "special_punct_spacing"},
            { "step": "whitespace_normalize", "params": { "collapse": true, "trim": true } }
        ]
    },

    "labels": {
        "num_labels": 15,
        "label_names": [
            "O",
            "B-COUNTRY", "I-COUNTRY",
            "B-EMIRATE", "I-EMIRATE",
            "B-CITY", "I-CITY",
            "B-SUB_AREA", "I-SUB_AREA",
            "B-COMPOUND", "I-COMPOUND",
            "B-STREET", "I-STREET",
            "B-BUILDING", "I-BUILDING"
        ],
        "label_mapping": {
            "O": 0,
            "B-COUNTRY": 1,
            "I-COUNTRY": 2,
            "B-EMIRATE": 3,
            "I-EMIRATE": 4,
            "B-CITY": 5,
            "I-CITY": 6,
            "B-SUB_AREA": 7,
            "I-SUB_AREA": 8,
            "B-COMPOUND": 9,
            "I-COMPOUND": 10,
            "B-STREET": 11,
            "I-STREET": 12,
            "B-BUILDING": 13,
            "I-BUILDING": 14
        },
        "ignore_index": -100
    },
    "evaluation": {
        "metrics": [
            "precision",
            "recall",
            "f1",
            "accuracy"
        ],
        "average": "weighted",
        "return_entity_level_metrics": true,
        "classification_report": true
    },
    "output": {
        "model_dir": "data/ner/models/uae",
        "results_dir": "data/ner/result/uae",
        "logs_dir": "data/ner/logs/uae",
        "predictions_file": "predictions.json",
        "save_total_limit": 3,
        "overwrite_output_dir": true
    },
    "hardware": {
        "device": "auto",
        "num_workers": 0,
        "pin_memory": true,
        "fp16": true,
        "dataloader_drop_last": false
    },
    "logging": {
        "level": "INFO",
        "log_file": "data/ner/logs/uae/example.log",
        "console_output": true,
        "wandb": {
            "enabled": false,
            "project": "ner-example",
            "entity": null,
            "tags": [
                "ner",
                "bert",
                "example"
            ]
        },
        "tensorboard": {
            "enabled": true,
            "log_dir": "runs/example"
        }
    }

}