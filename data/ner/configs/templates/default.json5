{
    // 国家配置信息
    "country": {
        "code": "{country_code}",
        "name": "{country_name}",
        "language": "",
        "description": "desc for {country_name}"
    },
    
    // 模型配置
    "model": {
        "name": "",
        "type": "bert",                 // 目前训练器仅在 type=="bert" 分支初始化（底座通过 AutoModel 兼容 XLM-R 等）
        "pretrained_model": "",         // 例如："xlm-roberta-base"
        "dropout": 0.1,                  // 分类头 dropout（训练器会使用）
        "config": {                      // 未使用：训练器不会读取此块
            "hidden_dropout_prob": 0.1,
            "attention_probs_dropout_prob": 0.1
        }
    },
    
    // 训练配置
    "training": {
        "epochs": 4,              // 训练轮数
        "batch_size": 16,         // 批次大小
        "learning_rate": 2e-5,    // 学习率
        "weight_decay": 0.01,     // 权重衰减
        "optimizer": "adamw",     // 优化器（训练器使用此字段）
        "scheduler": "linear",    // 学习率调度器（训练器使用此字段）
        "warmup_ratio": 0.1,      // 预热比例（训练器使用此字段）
        "early_stopping_patience": 3, // 早停耐心（训练器使用此字段）
        "warmup_steps": 500,      // 未使用：训练器按 warmup_ratio 计算
        "max_grad_norm": 1.0,     // 梯度裁剪
        "save_steps": 1000,       // 未使用
        "eval_steps": 500,        // 未使用
        "logging_steps": 100      // 未使用
    },
    
    // 数据配置
    "data": {
        "train_file": "data/ner/data/{country_code}/train.jsonl",
        "val_file": "data/ner/data/{country_code}/val.jsonl",
        "test_file": "data/ner/data/{country_code}/test.jsonl",
        "max_length": 128,        // 最大序列长度（训练器使用此字段）
        "doc_stride": 128,        // 未使用
        "preprocessing": {
            "lowercase": false,    // 是否转小写
            "remove_accents": false,
            "tokenize_chinese_chars": true
        },

        // 组合步骤式预处理流水线（优先级高于上面的 legacy 布尔开关）
        // 说明：按顺序执行；训练/评估阶段默认仅启用 label-safe 步骤
        // 可选常用步骤（均为 label-safe）：
        // 1) unicode_normalize：Unicode 归一（推荐 NFC/NFKC）
        // 2) arabic_remove_diacritics：阿语去重音/延音符
        // 3) whitespace_normalize：空白归一（合并多空格、首尾裁剪）
        // 4) lowercase：小写化（英文/大小写敏感任务酌情启用）
        // 5) punctuation_filter：标点过滤（支持保留/移除列表）
        // 其它可扩展步骤（示例，默认未实现或建议仅用于预测）：
        // - abbrev_synonym_map：缩写/同义映射（可能影响分词边界，训练默认禁用）
        // - number_normalize：数字格式统一（阿拉伯数字/西文数字互转等）
        // - mixed_script_normalize：混合文字系统统一
        "preprocessing_pipeline": [
            { "step": "unicode_normalize", "params": { "form": "NFC" } }, // 1) Unicode 归一
            { "step": "arabic_remove_diacritics" },                           // 2) 去重音
            { "step": "whitespace_normalize", "params": { "collapse": true, "trim": true } }, // 3) 空白归一
            // { "step": "lowercase" },                                       // 4) 小写化（按需启用）
            // { "step": "punctuation_filter", "params": { "keep": [",", "."] } }, // 5) 标点过滤示例
            // 以下步骤示例仅供参考，默认不启用：
            // { "step": "abbrev_synonym_map", "params": { "map": { "st": "street", "rd": "road" } } },
            // { "step": "number_normalize", "params": { "to": "latin" } },
            // { "step": "mixed_script_normalize" }
        ]
    },
    
    // 标签配置 - 标准 BIO 标注
    "labels": {
        "num_labels": 17,
        "label_names": [          // 标签名称
            "O",
            "B-PER", "I-PER",
            "B-ORG", "I-ORG", 
            "B-LOC", "I-LOC",
            "B-MISC", "I-MISC", 
            "B-ADDR", "I-ADDR", 
            "B-STREET", "I-STREET",
            "B-CITY", "I-CITY", 
            "B-STATE", "I-STATE"
        ],
        "label_mapping": {        //标签映射
            "O": 0, 
            "B-PER": 1, "I-PER": 2, 
            "B-ORG": 3, "I-ORG": 4,
            "B-LOC": 5, "I-LOC": 6, 
            "B-MISC": 7, "I-MISC": 8,
            "B-ADDR": 9, "I-ADDR": 10, 
            "B-STREET": 11, "I-STREET": 12,
            "B-CITY": 13, "I-CITY": 14, 
            "B-STATE": 15, "I-STATE": 16
        },
        "ignore_index": -100      // 忽略的标签索引
    },
    
    // 评估配置
    "evaluation": {
        "metrics": [
            "precision",   // 精确率
            "recall",      // 召回率
            "f1",          // F1分数
            "accuracy"     // 准确率
        ],
        "average": "weighted", // 平均方式：micro, macro, weighted
        "return_entity_level_metrics": true,
        "classification_report": true
    },
    
    // 输出配置
    "output": {
        "model_dir": "data/ner/models/{country_code}",
        "results_dir": "data/ner/result/{country_code}",
        "logs_dir": "data/ner/logs/{country_code}",
        "predictions_file": "predictions.json",
        "save_total_limit": 3,    // 最多保存的检查点数量
        "overwrite_output_dir": true
    },
    
    // 硬件配置
    "hardware": {
        "device": "auto",         // auto, cpu, cuda, mps
        "num_workers": 4,         // 数据加载器工作进程数（Windows 建议 0）
        "pin_memory": true,       // 是否固定内存
        "fp16": false,            // 是否使用半精度
        "dataloader_drop_last": false
    },
    
    // 日志配置
    "logging": {
        "level": "INFO",          // DEBUG, INFO, WARNING, ERROR
        "log_file": "data/ner/logs/{country_code}/example.log",
        "console_output": true,
        "wandb": {
            "enabled": false,     // 是否启用 Weights & Biases
            "project": "ner-example",
            "entity": null,
            "tags": ["ner", "bert", "example"]
        },
        "tensorboard": {
            "enabled": true,      // 是否启用 TensorBoard
            "log_dir": "runs/example"
        }
    },
    
}