{
    // 国家配置信息
    "country": {
        "code": "{country_code}",
        "name": "{country_name}",
        "language": "",
        "description": "desc for {country_name}"
    },
    
    // 模型配置
    "model": {
        "name": "",
        "type": "bert",
        "pretrained_model": "",
        "config": {
            "hidden_dropout_prob": 0.1,
            "attention_probs_dropout_prob": 0.1
        }
    },
    
    // 训练配置
    "training": {
        "epochs": 4,              // 训练轮数
        "batch_size": 16,         // 批次大小
        "learning_rate": 2e-5,    // 学习率
        "weight_decay": 0.01,     // 权重衰减
        "warmup_steps": 500,      // 预热步数
        "max_grad_norm": 1.0,     // 梯度裁剪
        "save_steps": 1000,       // 保存间隔
        "eval_steps": 500,        // 评估间隔
        "logging_steps": 100      // 日志间隔
    },
    
    // 数据配置
    "data": {
        "train_file": "data/ner/data/{country_code}/train.jsonl",
        "val_file": "data/ner/data/{country_code}/val.jsonl",
        "test_file": "data/ner/data/{country_code}/test.jsonl",
        "max_seq_length": 512,    // 最大序列长度
        "doc_stride": 128,        // 文档滑动窗口
        "preprocessing": {
            "lowercase": false,    // 是否转小写
            "remove_accents": false,
            "tokenize_chinese_chars": true
        }
    },
    
    // 标签配置 - 标准 BIO 标注
    "labels": {
        "num_labels": 17,
        "label_names": [          // 标签名称
            "O",
            "B-PER", "I-PER",
            "B-ORG", "I-ORG", 
            "B-LOC", "I-LOC",
            "B-MISC", "I-MISC", 
            "B-ADDR", "I-ADDR", 
            "B-STREET", "I-STREET",
            "B-CITY", "I-CITY", 
            "B-STATE", "I-STATE"
        ],
        "label_mapping": {        //标签映射
            "O": 0, 
            "B-PER": 1, "I-PER": 2, 
            "B-ORG": 3, "I-ORG": 4,
            "B-LOC": 5, "I-LOC": 6, 
            "B-MISC": 7, "I-MISC": 8,
            "B-ADDR": 9, "I-ADDR": 10, 
            "B-STREET": 11, "I-STREET": 12,
            "B-CITY": 13, "I-CITY": 14, 
            "B-STATE": 15, "I-STATE": 16
        },
        "ignore_index": -100      // 忽略的标签索引
    },
    
    // 评估配置
    "evaluation": {
        "metrics": [
            "precision",   // 精确率
            "recall",      // 召回率
            "f1",          // F1分数
            "accuracy"     // 准确率
        ],
        "average": "weighted", // 平均方式：micro, macro, weighted
        "return_entity_level_metrics": true,
        "classification_report": true
    },
    
    // 输出配置
    "output": {
        "model_dir": "data/ner/models/{country_code}",
        "results_dir": "data/ner/result/{country_code}",
        "logs_dir": "data/ner/logs/{country_code}",
        "predictions_file": "predictions.json",
        "save_total_limit": 3,    // 最多保存的检查点数量
        "overwrite_output_dir": true
    },
    
    // 硬件配置
    "hardware": {
        "device": "auto",         // auto, cpu, cuda, mps
        "num_workers": 4,         // 数据加载器工作进程数
        "pin_memory": true,       // 是否固定内存
        "fp16": false,            // 是否使用半精度
        "dataloader_drop_last": false
    },
    
    // 日志配置
    "logging": {
        "level": "INFO",          // DEBUG, INFO, WARNING, ERROR
        "log_file": "data/ner/logs/{country_code}/example.log",
        "console_output": true,
        "wandb": {
            "enabled": false,     // 是否启用 Weights & Biases
            "project": "ner-example",
            "entity": null,
            "tags": ["ner", "bert", "example"]
        },
        "tensorboard": {
            "enabled": true,      // 是否启用 TensorBoard
            "log_dir": "runs/example"
        }
    },
    
    // 优化器配置
    "optimizer": {
        "type": "AdamW",          // 优化器类型
        "betas": [0.9, 0.999],
        "eps": 1e-8,
        "amsgrad": false
    },
    
    // 学习率调度器配置
    "scheduler": {
        "type": "linear",        // linear, cosine, polynomial
        "num_warmup_steps": 500,
        "num_training_steps": null  // 自动计算
    },
    
    // 早停配置
    "early_stopping": {
        "enabled": true,
        "patience": 3,            // 容忍轮数
        "min_delta": 0.001,      // 最小改进阈值
        "monitor": "eval_f1"     // 监控指标
    }
}