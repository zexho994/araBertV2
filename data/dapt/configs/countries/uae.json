{
  "country": {
    "code": "uae",
    "name": "United Arab Emirates",
    "language": "ar",
    "dialect": "gulf_arabic",
    "region": "middle_east"
  },
  "model": {
    "base_model": "aubmindlab/bert-base-arabertv2",
    "model_type": "bert",
    "max_length": 512,
    "vocab_size": 64000,
    "hidden_size": 768,
    "num_attention_heads": 12,
    "num_hidden_layers": 12,
    "intermediate_size": 3072,
    "dropout_rate": 0.1,
    "attention_dropout": 0.1
  },
  "training": {
    "learning_rate": 2e-5,
    "batch_size": 16,
    "gradient_accumulation_steps": 2,
    "epochs": 2,
    "warmup_steps": 500,
    "weight_decay": 0.01,
    "adam_epsilon": 1e-8,
    "max_grad_norm": 1.0,
    "scheduler_type": "linear",
    "warmup_ratio": 0.1,
    "save_strategy": "steps",
    "save_steps": 500,
    "save_total_limit": 3,
    "logging_strategy": "steps",
    "logging_steps": 100,
    "fp16": true,
    "dataloader_num_workers": 4,
    "dataloader_pin_memory": true,
    "seed": 42,
    "data_seed": 42
  },
  "data": {
    "train_file": "dapt_data/training_data/uae/train.txt",
    "validation_file": "dapt_data/training_data/uae/validation.txt",
    "test_file": "dapt_data/training_data/uae/test.txt",
    "data_format": "text",
    "text_column": "text",
    "preprocessing": {
      "clean_text": true,
      "normalize_arabic": true,
      "remove_diacritics": false,
      "remove_punctuation": false,
      "lowercase": false,
      "normalize_numbers": true,
      "convert_english_numbers": true,
      "handle_mixed_script": true,
      "max_length": 512,
      "padding": "max_length",
      "truncation": true,
      "return_attention_mask": true,
      "return_token_type_ids": false
    }
  },
  "output": {
    "output_dir": "dapt_data/models/uae",
    "logs_dir": "dapt_data/logs/uae",
    "cache_dir": "cache/uae",
    "save_model": true,
    "save_tokenizer": true,
    "save_config": true
  },
  "hardware": {
    "device": "auto",
    "gpu_ids": [0],
    "max_memory_gb": 16,
    "gradient_checkpointing": true,
    "distributed": false,
    "use_fast_tokenizer": true,
    "torch_compile": false
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "log_file": "uae_dapt_training.log",
    "progress_bar": true,
    "verbose": true
  },
  "environment": {
    "TOKENIZERS_PARALLELISM": "false",
    "CUDA_VISIBLE_DEVICES": "0",
    "PYTHONPATH": "./src",
    "HF_HOME": "./cache/huggingface",
    "TRANSFORMERS_CACHE": "./cache/transformers"
  }
}