{
  // 国家和语言配置 - 定义目标国家的语言特征
  "country": {
    "code": "",           // 国家代码，如 "uae", "saudi", "egypt" 等
    "name": "",           // 国家全名，如 "United Arab Emirates"
    "language": "ar",     // 语言代码，阿拉伯语为 "ar"
    "script": "arabic",   // 文字系统，阿拉伯文为 "arabic"
    "dialect": "msa"      // 方言类型：msa(现代标准阿拉伯语), gulf(海湾方言), levantine(黎凡特方言), maghrebi(马格里布方言), egyptian(埃及方言)
  },
  // 模型配置 - 定义预训练模型和架构参数
  "model": {
    "base_model": "aubmindlab/bert-base-arabertv2",  // 基础预训练模型，推荐使用AraBERT v2用于阿拉伯语任务
    "max_length": 128,                              // 最大序列长度，范围64-512，较短序列训练更快但可能截断重要信息
    "num_labels": 9,                                // 标签数量，需与labels部分的标签数量一致
    "dropout_rate": 0.1,                           // 通用dropout率，范围0.1-0.3，防止过拟合
    "hidden_dropout_prob": 0.1,                    // 隐藏层dropout概率，范围0.1-0.3，控制隐藏层正则化强度
    "attention_probs_dropout_prob": 0.1            // 注意力机制dropout概率，范围0.1-0.3，防止注意力权重过拟合
  },
  // 训练配置 - 控制训练过程的关键超参数
  "training": {
    "epochs": 10,                           // 训练轮数，范围5-50，根据数据集大小调整
    "batch_size": 16,                       // 批次大小，范围8-64，受GPU内存限制，较大批次训练更稳定
    "learning_rate": 2e-05,                 // 学习率，范围1e-5到5e-5，BERT微调的典型范围
    "weight_decay": 0.01,                   // 权重衰减，范围0.01-0.1，L2正则化防止过拟合
    "warmup_steps": 500,                    // 预热步数，通常为总步数的10%，学习率线性增长阶段
    "save_steps": 1000,                     // 模型保存间隔步数，平衡存储空间和训练安全性
    "eval_steps": 500,                      // 评估间隔步数，建议为save_steps的一半
    "logging_steps": 100,                   // 日志记录间隔，用于监控训练进度
    "gradient_accumulation_steps": 1,       // 梯度累积步数，模拟更大批次，当GPU内存不足时增加此值
    "max_grad_norm": 1.0,                   // 梯度裁剪阈值，防止梯度爆炸，范围0.5-2.0
    "lr_scheduler_type": "linear",          // 学习率调度器：linear(线性衰减), cosine(余弦衰减), constant(恒定)
    "metric_for_best_model": "f1",          // 最佳模型评估指标：f1, accuracy, precision, recall
    "greater_is_better": true               // 指标越大越好，f1/accuracy为true，loss为false
  },
  // 数据配置 - 定义训练数据和预处理参数
  "data": {
    "train_file": "",                    // 训练数据文件路径，支持CSV/JSON格式
    "validation_file": "",               // 验证数据文件路径，用于训练过程中的模型评估
    "test_file": "",                     // 测试数据文件路径，用于最终模型性能评估
    "text_column": "text",               // 文本列名，数据文件中包含输入文本的列
    "label_column": "labels",            // 标签列名，数据文件中包含标注标签的列
    "preprocessing": {
      "lowercase": false,                 // 是否转换为小写，阿拉伯语建议保持false
      "remove_diacritics": true,          // 是否移除阿拉伯语音标，通常设为true以提高泛化性
      "normalize_arabic": true,           // 是否标准化阿拉伯语字符，统一不同形式的字符
      "max_length": 128,                  // 预处理最大长度，需与model.max_length一致
      "padding": "max_length",            // 填充策略：max_length(填充到最大长度), longest(批次内最长), do_not_pad(不填充)
      "truncation": true                  // 是否截断超长序列，建议设为true防止内存溢出
    }
  },
  // 标签配置 - 定义命名实体识别的标签体系（BIO标注格式）
  "labels": {
    "label_names": [
      "O",           // Outside：非实体标签
      "B-STREET",    // Begin-Street：街道名称的开始标签
      "I-STREET",    // Inside-Street：街道名称的内部标签
      "B-BUILDING",  // Begin-Building：建筑物名称的开始标签
      "I-BUILDING",  // Inside-Building：建筑物名称的内部标签
      "B-AREA",      // Begin-Area：区域名称的开始标签
      "I-AREA",      // Inside-Area：区域名称的内部标签
      "B-CITY",      // Begin-City：城市名称的开始标签
      "I-CITY"       // Inside-City：城市名称的内部标签
    ],
    "label_mapping": {  // 标签到数字ID的映射，用于模型训练
      "O": 0,
      "B-STREET": 1,
      "I-STREET": 2,
      "B-BUILDING": 3,
      "I-BUILDING": 4,
      "B-AREA": 5,
      "I-AREA": 6,
      "B-CITY": 7,
      "I-CITY": 8
    }
  },
  // 评估配置 - 定义模型性能评估的指标和策略
  "evaluation": {
    "metrics": [                          // 评估指标列表
      "accuracy",                         // 准确率：正确预测的样本比例
      "f1",                              // F1分数：精确率和召回率的调和平均数，适合不平衡数据
      "precision",                       // 精确率：预测为正例中实际为正例的比例
      "recall"                           // 召回率：实际正例中被正确预测的比例
    ],
    "average": "weighted",                // 多类别平均方式：weighted(加权), macro(宏平均), micro(微平均)
    "save_predictions": true,             // 是否保存预测结果，便于后续分析和错误诊断
    "compute_metrics_each_epoch": true    // 是否每个epoch计算指标，有助于监控训练进度
  },
  // 输出配置 - 控制模型保存和输出策略
  "output": {
    "model_name": "",                     // 模型名称，用于保存文件夹命名
    "save_total_limit": 3,                // 最多保存的检查点数量，防止磁盘空间不足
    "save_best_model": true,              // 是否保存最佳模型，基于metric_for_best_model指标
    "load_best_model_at_end": true,       // 训练结束时是否加载最佳模型
    "save_strategy": "steps",             // 保存策略：steps(按步数), epoch(按轮数), no(不保存)
    "evaluation_strategy": "steps"        // 评估策略：steps(按步数), epoch(按轮数), no(不评估)
  },
  // 硬件配置 - 优化训练性能和资源使用
  "hardware": {
    "device": "auto",                     // 设备选择：auto(自动), cuda(GPU), cpu(CPU)
    "fp16": true,                         // 是否使用半精度浮点数，可节省GPU内存并加速训练
    "dataloader_num_workers": 4,          // 数据加载器工作进程数，范围0-8，提高数据加载速度
    "dataloader_pin_memory": true         // 是否将数据固定在内存中，GPU训练时建议开启
  },
  // 日志配置 - 控制训练过程的日志记录和监控
  "logging": {
    "level": "INFO",                      // 日志级别：DEBUG, INFO, WARNING, ERROR
    "log_file": "",                       // 日志文件路径，为空则只输出到控制台
    "tensorboard_dir": "",                // TensorBoard日志目录，用于可视化训练过程
    "report_to": [                        // 报告目标列表
      "tensorboard"                       // 支持：tensorboard, wandb, comet_ml, mlflow
    ]
  }
}